{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Desktop Assistant",
  "version": "0.1.0",
  "identifier": "com.ragpet.desktop",
  "build": {
    "frontendDist": "../desktop",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "Desktop Assistant",
        "url": "http://127.0.0.1:3000/pet.html",
        "width": 960,
        "height": 680,
        "minWidth": 620,
        "minHeight": 500,
        "resizable": true,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "shadow": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' http://127.0.0.1:3000; script-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
