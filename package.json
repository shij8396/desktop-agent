{
  "name": "rag-agent",
  "version": "0.1.0",
  "description": "Personal knowledge base Q&A agent with RAG",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:desktop": "node scripts/check-desktop.mjs",
    "eval:sync": "tsx scripts/sync-langsmith-dataset.ts",
    "eval:agent": "tsx scripts/eval-agent.ts",
    "eval:runtime": "tsx scripts/eval-runtime.ts",
    "serve": "tsx src/server.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run package:windows",
    "prepare:release": "npm run build && node scripts/prepare-release.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "package:windows": "npm run prepare:release && npm run smoke:release && tauri build --bundles nsis --config src-tauri/tauri.release.conf.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "@langchain/core": "1.2.13",
    "@langchain/langgraph": "1.4.18",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@langchain/openai": "1.6.0",
    "deepagents": "1.14.1",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "hono": "^4.12.18",
    "langchain": "1.5.14",
    "langsmith": "0.9.0",
    "mammoth": "^1.12.0",
    "msedge-tts": "^2.0.7",
    "pdf-parse": "^1.1.1",
    "playwright-core": "^1.63.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
