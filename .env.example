# DeepSeek mode.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# Free local mode. Install Ollama, then run: ollama pull qwen2.5:7b
# LLM_PROVIDER=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b

# Paid OpenAI mode:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL=gpt-5.4-mini

SERVER_PORT=3000
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5

# Optional LangSmith tracing. Disabled by default so local conversations are
# not uploaded unless the user explicitly enables it.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=rag-agent-desktop
